# ==============================================================================
# PontoVision AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env or secrets to version control!
# ==============================================================================

# Server & Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB)
# If using local MongoDB:
MONGODB_URI=mongodb://localhost:27017/pontovision
# If using MongoDB Atlas, configure your connection string in your local .env:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pontovision?retryWrites=true&w=majority

# Security & JWT Tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# File Storage & Uploads
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Local OCR Settings (Tesseract.js)
# Completely local execution - NO external paid APIs or cloud vision services
OCR_LANGUAGE=por
OCR_CACHE_PATH=./uploads/tesseract-cache

# Frontend Settings (Vite)
VITE_API_URL=http://localhost:3000/api/v1
